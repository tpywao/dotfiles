# Brewfile.gui (常用GUIアプリ)
# GUI環境で常に使用する cask を管理
# 用途限定のオプションアプリは Brewfile.gui.opt で管理
#
# インストール: brew bundle --file=brew/Brewfile.gui
# 差分確認:    brew bundle check --file=brew/Brewfile.gui

# development
cask "docker"
# cask "alacritty"
# cask "figma"
# cask "inkscape"
# cask "kiro"

# brower
# cask "floorp"
# cask "sigmaos"
cask "google-chrome"

# utils
cask "keyclu"
cask "notunes" # メディアキーによる Apple Music の起動を抑止
cask "raycast"
cask "rectangle"
cask "stats"
