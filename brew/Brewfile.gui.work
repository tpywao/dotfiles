# Brewfile.gui.work (業務用マシンのGUIアプリ)
# 業務で使うマシンにだけ入れる cask を管理
#
# インストール: brew bundle --file=brew/Brewfile.gui.work
# 差分確認:    brew bundle check --file=brew/Brewfile.gui.work

# development
cask "postman"
cask "tableplus"
cask "visual-studio-code"

# brower
cask "firefox@esr"

# utils
cask "claude"
cask "notion"
cask "notion-calendar"
cask "slack"
