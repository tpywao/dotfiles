{
  "skillOverrides": {
    "complexity": "name-only"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(find * -delete*)",
      "Bash(find -delete*)",
      "Bash(find * -exec*)",
      "Bash(find -exec*)",
      "Bash(find * -ok*)",
      "Bash(find -ok*)",
      "Bash(rg --pre=*)",
      "Bash(rg * --pre=*)",
      "Bash(rg --pre *)",
      "Bash(rg * --pre *)",
      "Bash(rg --hostname-bin=*)",
      "Bash(rg * --hostname-bin=*)",
      "Bash(rg --hostname-bin *)",
      "Bash(rg * --hostname-bin *)",
      "Bash(git log * --output*)",
      "Bash(git log --output*)",
      "Bash(git diff * --output*)",
      "Bash(git diff --output*)",
      "Bash(git show * --output*)",
      "Bash(git show --output*)"
    ],
    "allow": [
      "Bash(python manage.py test *)",
      "Bash(uv run ruff check)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__backlog__get_issue",
      "Bash(gh pr *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(gh issue *)",
      "Bash(rg *)",
      "Bash(git show *)",
      "Bash(grep *)",
      "Bash(gh run *)",
      "Bash(find *)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(jq *)",
      "Bash(npm list *)",
      "Bash(docker ps *)",
      "Bash(git worktree list)",
      "Bash(dwt:*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledMcpjsonServers": [
    "playwright",
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dangerous.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject-context.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/update-usage.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/relink-claude-files.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "genshijin@genshijin": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    }
  },
  "language": "japanese",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "verbose": false
}
