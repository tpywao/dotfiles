[alias]
  co = checkout
  ci = commit
  st = status --short --branch
  br = branch
  sw = switch
  hist = log --graph --date=short --decorate --oneline
  adl = add -v --all
  adt = add -v .
  adm = add -v --update
  adp = add --patch
  ls = ls-files
  reci = commit --amend
  wip = !git commit --allow-empty -m 'wip'
  sb = show-branch
  dfw = diff --ignore-all-space
  dfs = diff --staged
  dfh = diff HEAD
  # pcd = !git diff -U0 HEAD | grep -E -e "^\+ *# " -e '^diff' | grep -v 'TODO'
  # Print New Commented line (python)
  pnc = !git diff --unified=0 HEAD | grep -E -e "\"^\\+ *#\"" -e '^diff' | grep -v -e TODO: -e FIXME: -e OPTIMEZE: -e WIP:
  todo = grep --heading --line-number -e TODO: -e FIXME: -e OPTIMEZE: -e WIP:
  cpush = !git push -u origin `git branch --show-current`
  pclone = clone --depth 1 --filter=blob:none --sparse
  brprune = !git branch -d $(git for-each-ref --format '%(if)%(upstream:track)%(then)%(refname:short)%(end)')
[diff]
  renames = true
[color]
  ui = auto
[gui]
  encoding = utf-8
[core]
	pager = "if command -v delta >/dev/null 2>&1; then delta; else less -FRX; fi"
	quotepath = false
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then delta --color-only; else cat; fi"
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[push]
  default = simple
[include]
	path = ~/.gitconfig.local
[rebase]
  autosquash = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[pull]
  ff = only
[fetch]
  prune = true
[init]
  defaultBranch = main
[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true
