[alias]
	co = checkout
	ci = commit
	st = status --short --branch
	br = branch
	hist = log --graph --date=short --decorate --oneline
	adl = add --all
	adt = add .
	adm = add --update
	ls = ls-files
	reci = commit --amend
	sb = show-branch
	dfw = diff --ignore-all-space
	adp = add --patch
[diff]
	renames = true
[color]
	ui = auto
[core]
	excludesfile = $HOME/.gitignore
[pager]
	log = diff-highlight | less
	show = diff-highlight | less
	diff = diff-highlight | less
[push]
	default = simple
