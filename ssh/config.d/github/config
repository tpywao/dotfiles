# # https://help.github.com/articles/using-ssh-over-the-https-port/
# Host github.com
#   HostName ssh.github.com
#   User git
#   Port 443
#   IdentitiesOnly yes

Host github.com
  User git
  HostName github.com
  IdentityFile ~/.ssh/config.d/github/id_rsa

Host gist.github.com
  User git
  HostName gist.github.com
  IdentityFile ~/.ssh/config.d/github/id_rsa

