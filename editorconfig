# ~/.editorconfig へ配布する設定（install.sh がリンクする）。
# このリポジトリ自身に効かせる設定は .editorconfig（ドットあり）に分けてある。
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 4

[*.py]
indent_size = 4

[*.rs]
indent_size = 4
