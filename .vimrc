set title
set showmode
set showcmd

set nu
set ruler

set showmatch
set list
set lcs=eol:\ ,tab:\>-,trail:-


set expandtab
set autoindent
set tabstop=2
set shiftwidth=2



set cpo-=<
map z $
map <Up> <Nop>
map <Down> <Nop>
map <Left> <Nop>
map <Right> <Nop>
inoremap <Up> <Nop>
inoremap <Down> <Nop>
inoremap <Left> <Nop>
inoremap <Right> <Nop>

