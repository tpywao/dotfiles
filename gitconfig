[alias]
	co = checkout
	ci = commit
	st = status --short --branch
	br = branch
	hist = log --graph --date=short --decorate --oneline
	adl = add -v --all
	adt = add -v .
	adm = add -v --update
	adp = add --patch
	ls = ls-files
	reci = commit --amend
	sb = show-branch
	dfw = diff --ignore-all-space
	dfs = diff --staged
	dfh = diff HEAD
[diff]
	renames = true
[color]
	ui = auto
[core]
	excludesfile = /Users/ke-ichi/.gitignore_global
[pager]
	log = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	show = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	diff = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
[push]
	default = simple
[include]
	path = ~/.gitconfig.local
[rebase]
	autosquash = true
[user]
	name = tpywao
	email = tpywao@gmail.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/ke-ichi/.stCommitMsg
