[alias]
	co = checkout
	# checkout to previous branch
	cop = checkout @{-1}
	ci = commit
	st = status --short --branch
	br = branch
	hist = log --graph --date=short --decorate --oneline
	adl = add -v --all
	adt = add -v .
	adm = add -v --update
	adp = add --patch
	ls = ls-files
	reci = commit --amend
	sb = show-branch
	dfw = diff --ignore-all-space
	dfs = diff --staged
	dfh = diff HEAD
	# pcd = !git diff -U0 HEAD | grep -E -e "^\+ *# " -e '^diff' | grep -v 'TODO'
# Print New Commented line (python)
	pnc = !git diff --unified=0 HEAD | grep -E -e "\"^\\+ *#\"" -e '^diff' | grep -v -e TODO: -e FIXME: -e OPTIMEZE: -e WIP:
	todo = grep --heading --line-number -e TODO: -e FIXME: -e OPTIMEZE: -e WIP:
	cpush = !git push -u origin `git rev-parse --abbrev-ref HEAD`
	sw = switch
	pclone = clone --depth 1 --filter=blob:none --sparse
[diff]
	renames = true
[color]
	ui = auto
[core]
	excludesfile = /Users/ke-ichi/.gitignore_global
[pager]
	log = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	show = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	diff = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
[push]
	default = simple
[include]
	path = ~/.gitconfig.local
[rebase]
	autosquash = true
[user]
	name = tpywao
	email = tpywao@gmail.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/ke-ichi/.stCommitMsg
[ghq]
	root = /Volumes/extssd/src
	root = /Users/ke-ichi/local/src/repositories
[pull]
	ff = only
[fetch]
	prune = true
[init]
	defaultBranch = main
