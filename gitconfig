[alias]
	co = checkout
	ci = commit
	st = status --short --branch
	br = branch
	hist = log --graph --date=short --decorate --oneline
	adl = add --all
	adt = add .
	adm = add --update
	ls = ls-files
	reci = commit --amend
	sb = show-branch
	dfw = diff --ignore-all-space
	adp = add --patch
	dfs = diff --staged
	dfh = diff HEAD
[diff]
	renames = true
[color]
	ui = auto
[core]
	excludesfile = $HOME/.gitignore
[pager]
	log = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	show = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
	diff = type diff-highlight >/dev/null 2>&1 && diff-highlight | less || less
[push]
	default = simple
[include]
	path = ~/.gitconfig.local
[rebase]
	autosquash = true
